// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ClassType {
  INDIVIDUAL
  GROUP
  MASS
}

enum PostType {
  STUDENT_REQUEST
  TEACHER_OFFERING
}

enum InquiryStatus {
  PENDING
  RESPONDED
  ACCEPTED
  REJECTED
  CANCELLED
}

enum TimeSlotStatus {
  AVAILABLE
  SELECTED
  CONFIRMED
  BOOKED
  CANCELLED
}

enum BookingStatus {
  PENDING_PAYMENT
  PAYMENT_COMPLETED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum WalletTransactionType {
  DEPOSIT    // teacher: a paid booking lands in escrow
  WITHDRAWAL // teacher: money requested out to a bank account
  RELEASE    // teacher: escrow clears into the withdrawable balance
  REVERSAL   // teacher: escrow taken back when a booking is cancelled
  TOP_UP     // student: money added to the wallet by card
  PAYMENT    // student: wallet balance spent on a class
  REFUND     // student: a cancelled booking's money returned to the wallet
}

enum WithdrawalStatus {
  PENDING    // requested by the teacher, awaiting payout
  PROCESSING // payout initiated
  PAID       // money sent
  REJECTED   // refused — amount returned to the wallet
  CANCELLED  // withdrawn by the teacher — amount returned to the wallet
}

enum NotificationType {
  INQUIRY_RECEIVED
  SLOT_CONFIRMED
  PAYMENT_SUCCESS
  MEETING_LINK_CREATED
  CLASS_COMPLETION
  VERIFICATION_STATUS
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  firstName     String
  lastName      String
  phone         String?
  role          UserRole  @default(STUDENT)
  isActive      Boolean   @default(true)
  emailVerified Boolean   @default(false)
  emailOtp        String?   // bcrypt hash of the current verification code
  emailOtpExpiry  DateTime? // when the current code expires
  notifyEmail   Boolean   @default(true) // notification preference: email
  notifyInApp   Boolean   @default(true) // notification preference: in-app
  currency      String    @default("LKR") // account display + transaction currency (LKR | USD)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  teacherProfile TeacherProfile?
  studentProfile StudentProfile?
  posts          Post[]
  inquiriesSent  Inquiry[] @relation("InquirySender")
  inquiriesReceived Inquiry[] @relation("InquiryReceiver")
  bookingsAsStudent Booking[] @relation("StudentBooking")
  bookingsAsTeacher Booking[] @relation("TeacherBooking")
  wallet         Wallet?
  notifications  Notification[]
  postLikes      PostLike[]
  comments       Comment[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model TeacherProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  bio         String?
  experience  Int?     // years of experience
  subjects    String[] // array of subjects taught
  hourlyRate Decimal? @db.Decimal(10, 2)

  // Personal details (profile step 1)
  fullName         String?
  nameWithInitials String?
  contactNumber    String?
  contactNumber2   String?  // optional secondary contact
  address          String?
  country          String?
  postalCode       String?

  // Identity verification (profile step 2)
  idType           String?  // NIC | LICENSE | PASSPORT

  // Academic / professional background (profile step 3)
  employmentStatus String?  // STUDENT | UNDERGRADUATE | GRADUATE
  universityName   String?  // for students/undergraduates
  universityCountry String?
  workingStatus    String?  // for graduates
  profession       String?
  employer         String?

  // Bank details (for withdrawals — managed from Settings)
  bankAccountName   String?
  bankAccountNumber String?
  bankName          String?
  bankBranch        String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  verificationDocs    VerificationDocument[]
  verificationStatus  VerificationStatus    @default(PENDING)

  @@map("teacher_profiles")
}

model StudentProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  grade     String?
  interests String[] // array of subjects interested in
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

model VerificationDocument {
  id          String             @id @default(cuid())
  teacherId   String
  documentType String            // e.g., "ID", "QUALIFICATION", "CERTIFICATE"
  documentUrl String             // URL to stored document
  status      VerificationStatus @default(PENDING)
  reviewedBy  String?           // Admin user ID
  reviewedAt  DateTime?
  rejectionReason String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  teacher TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@index([status])
  @@map("verification_documents")
}

model Post {
  id          String   @id @default(cuid())
  userId      String
  type        PostType
  title       String
  description String   @db.Text
  subject     String
  grade       String?  // for student requests
  syllabus    String?  // for student requests
  fee         Decimal? @db.Decimal(10, 2) // for teacher offerings (per-class, = rate × duration)
  ratePerHour Decimal? @db.Decimal(10, 2) // for teacher offerings — hourly rate
  currency    String   @default("LKR")    // currency of the fee (LKR | USD)
  experience  Int?     // for teacher offerings
  classTypes  ClassType[]                 // INDIVIDUAL | GROUP | MASS (teacher may offer several)
  maxStudents Int?                         // optional cap for GROUP classes
  thumbnailUrl String? @db.Text           // optional class thumbnail (data URL or URL)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  inquiries Inquiry[]
  timeSlots TimeSlot[]
  likes     PostLike[]
  comments  Comment[]

  @@index([userId])
  @@index([type])
  @@index([subject])
  @@index([isActive])
  @@map("posts")
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
  @@map("post_likes")
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([userId])
  @@map("comments")
}

model Inquiry {
  id          String        @id @default(cuid())
  postId      String
  senderId    String
  receiverId  String
  message     String        @db.Text
  status      InquiryStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  sender   User   @relation("InquirySender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User   @relation("InquiryReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  timeSlots TimeSlot[]
  booking  Booking?

  @@index([postId])
  @@index([senderId])
  @@index([receiverId])
  @@index([status])
  @@map("inquiries")
}

model TimeSlot {
  id          String          @id @default(cuid())
  postId      String?
  inquiryId   String?
  startTime   DateTime
  endTime     DateTime
  status      TimeSlotStatus  @default(AVAILABLE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  post    Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  inquiry Inquiry? @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  booking Booking?

  @@index([postId])
  @@index([inquiryId])
  @@index([startTime, endTime])
  @@index([status])
  @@map("time_slots")
}

model Booking {
  id                String        @id @default(cuid())
  inquiryId         String        @unique
  studentId         String
  teacherId         String
  timeSlotId        String        @unique
  status            BookingStatus @default(PENDING_PAYMENT)
  fee               Decimal       @db.Decimal(10, 2)
  googleMeetLink    String?
  studentConfirmed  Boolean       @default(false)
  teacherConfirmed  Boolean       @default(false)
  completedAt       DateTime?
  cancelledAt       DateTime?
  cancellationReason String?      @db.Text
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  inquiry   Inquiry   @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  student   User      @relation("StudentBooking", fields: [studentId], references: [id], onDelete: Cascade)
  teacher   User      @relation("TeacherBooking", fields: [teacherId], references: [id], onDelete: Cascade)
  timeSlot  TimeSlot  @relation(fields: [timeSlotId], references: [id], onDelete: Cascade)
  payment   Payment?
  walletTransactions WalletTransaction[]

  @@index([studentId])
  @@index([teacherId])
  @@index([status])
  @@index([timeSlotId])
  @@map("bookings")
}

model Payment {
  id            String        @id @default(cuid())
  bookingId     String        @unique
  gatewayPaymentId String?    @unique // PayHere's payment_id, once the payment settles
  amount        Decimal       @db.Decimal(10, 2)
  status        PaymentStatus @default(PENDING)
  currency      String        @default("LKR")
  metadata      Json?         // Additional payment metadata
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([gatewayPaymentId])
  @@index([status])
  @@map("payments")
}

model Wallet {
  id              String   @id @default(cuid())
  userId          String   @unique
  pendingBalance  Decimal  @default(0) @db.Decimal(10, 2) // teacher: held in escrow until the class is over
  releasedBalance Decimal  @default(0) @db.Decimal(10, 2) // spendable balance — withdrawable for a teacher, usable at checkout for a student
  totalEarnings   Decimal  @default(0) @db.Decimal(10, 2) // teacher: lifetime released earnings
  totalSpent      Decimal  @default(0) @db.Decimal(10, 2) // student: lifetime spent from the wallet on classes
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
  withdrawals  Withdrawal[]

  @@index([userId])
  @@map("wallets")
}

model WalletTransaction {
  id            String                @id @default(cuid())
  walletId      String
  bookingId     String?
  type          WalletTransactionType
  amount        Decimal               @db.Decimal(10, 2)
  description   String?               @db.Text
  status        String                @default("PENDING") // PENDING, COMPLETED, FAILED
  reference     String?               @unique // gateway id for money moving in, e.g. the PayHere payment behind a top-up
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  wallet     Wallet      @relation(fields: [walletId], references: [id], onDelete: Cascade)
  booking    Booking?    @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  withdrawal Withdrawal?

  // One entry of each kind per booking *per wallet* — this is what makes
  // crediting, releasing, paying and refunding safe to retry. Scoping it to the
  // wallet lets both sides of a booking keep their own entries.
  @@unique([walletId, bookingId, type])
  @@index([walletId])
  @@index([bookingId])
  @@index([type])
  @@index([status])
  @@map("wallet_transactions")
}

model Withdrawal {
  id            String           @id @default(cuid())
  walletId      String
  transactionId String           @unique // the WITHDRAWAL wallet entry this request debited
  amount        Decimal          @db.Decimal(10, 2)
  currency      String           @default("LKR")
  status        WithdrawalStatus @default(PENDING)

  // Payout destination, snapshotted at request time so later edits to the
  // teacher's bank details don't rewrite past requests.
  bankAccountName   String?
  bankAccountNumber String?
  bankName          String?
  bankBranch        String?

  reference   String?   // payout/transfer reference once paid
  note        String?   @db.Text // rejection reason or admin note
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  wallet      Wallet            @relation(fields: [walletId], references: [id], onDelete: Cascade)
  transaction WalletTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([status])
  @@map("withdrawals")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String           @db.Text
  isRead    Boolean          @default(false)
  metadata  Json?            // Additional notification data
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

