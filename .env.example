# Database (Supabase)
# App queries go through the transaction pooler (port 6543). src/lib/prisma.ts
# adds pgbouncer=true, connection_limit and pool_timeout when they're missing.
# Don't set connection_limit=1 here: it queues every parallel query behind one
# connection, and that causes P2024 timeouts.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"
# Migrations need a session connection: the session pooler (port 5432) or the direct host.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Optional pool tuning (defaults: 5 connections, 20s wait)
# PRISMA_CONNECTION_LIMIT=5
# PRISMA_POOL_TIMEOUT=20
